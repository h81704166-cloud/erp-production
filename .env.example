# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server Port Configuration
PORT=3000

# PostgreSQL Database Configuration (Local Ubuntu Server / Cloud Run)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="local_erp"
DB_USER="erp_admin"
DB_PASSWORD="your_secure_db_password_here"

# Authentication & Security Secrets
JWT_SECRET="your_production_jwt_secret_key_change_me"
SERVER_ADMIN_EMAIL="sysadmin@billkart.shop"
SERVER_ADMIN_PASSWORD_HASH=""
SERVER_ADMIN_SALT=""
SERVER_ADMIN_JWT_SECRET="your_isolated_server_admin_jwt_secret"

# Payment Gateway Integrations
PAYTM_MID="YOUR_PAYTM_MERCHANT_ID"
PAYTM_KEY="YOUR_PAYTM_MERCHANT_KEY"
PHONEPE_MERCHANT_ID="YOUR_PHONEPE_MERCHANT_ID"
PHONEPE_SALT_KEY="YOUR_PHONEPE_SALT_KEY"

# Google Sheets API Integration (Daily 24-Hour Automated Cron Export)
GOOGLE_SHEET_ID="your_google_sheet_spreadsheet_id"
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL="your-service-account@iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# Supabase Integration (Netlify + Supabase Live Deploy)
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SMTP Email OTP Configuration (Optional for real email delivery via Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="BillKart Vyapar <your-email@gmail.com>"
SMTP_SECURE="false"
